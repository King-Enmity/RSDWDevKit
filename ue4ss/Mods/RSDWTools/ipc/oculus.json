{
  "version": 2,
  "sections": [
    {
      "name": "Init",
      "gate": "init",
      "commands": [
        {
          "name": "Unlock Distance",
          "verb": "camera.oculus.distance 999999 999999"
        },
        {
          "name": "Default Speed",
          "verb": "camera.oculus.speed 1200 4000 8000"
        },
        {
          "name": "NoClip",
          "verb": "player.field.set pawn.OculusComponent.OculusPawn bActorEnableCollision false",
          "verb_off": "player.field.set pawn.OculusComponent.OculusPawn bActorEnableCollision true"
        },
        {
          "name": "Hide Vignette",
          "verb": "camera.oculus.vignette off"
        },
        {
          "name": "Hide Watermark",
          "verb": "camera.oculus.watermark off"
        },
        {
          "name": "Save Building Costs",
          "verb": "world.buildings.requirements save"
        },
        {
          "name": "Clear Building Costs",
          "verb": "world.buildings.requirements clear"
        },
        {
          "name": "Placement Distance",
          "verb": "player.field.set controller.BuildPlacementComponent MaxPlacementDistance 1000.0"
        },
        {
          "name": "No Damage",
          "verb": "player.field.set pawn.PlayerDamageComponent bCanTakeDamage false"
        }
      ]
    },
    {
      "name": "Inactive",
      "gate": "inactive",
      "commands": [
        {
          "name": "Start",
          "verb": "camera.oculus.start",
          "hotkey": "INS"
        }
      ]
    },
    {
      "name": "Active",
      "gate": "active",
      "commands": [
        {
          "name": "Camera Speed",
          "verb": "camera.oculus.speed 3600 12000 24000",
          "verb_off": "camera.oculus.speed 1200 4000 8000",
          "umg_text": "Fast (3x)",
          "umg_text_off": "Default",
          "hotkey": "ONE",
          "hotkey_mode": "toggle"
        },
        {
          "name": "HUD",
          "verb": "player.field.call hud ShowHUD",
          "verb_off": "player.field.call hud ShowHUD",
          "verbs": [
            "player.field.call hud ShowHUD",
            "camera.oculus.watermark off",
            "camera.oculus.help off"
          ],
          "verbs_off": [
            "player.field.call hud ShowHUD",
            "camera.oculus.help on"
          ],
          "umg_text": "Hidden",
          "umg_text_off": "Visible",
          "hotkey": "TWO",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Time",
          "verb": "world.time 1.0",
          "verb_off": "world.time 0",
          "umg_text": "Toggle",
          "umg_text_off": "Toggle",
          "hotkey": "THREE",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Weather",
          "verb": "world.weather.regional Sunny",
          "verbs": [
            "world.weather.regional Sunny",
            "umg 3 Setting Sunny: Please Wait"
          ],
          "umg_text": "Sunny",
          "hotkey": "FOUR"
        },
        {
          "name": "AI",
          "verb": "world.foreach DominionAICharacter set CustomTimeDilation 0",
          "verb_off": "world.foreach DominionAICharacter set CustomTimeDilation 1.0",
          "umg_text": "Paused",
          "umg_text_off": "Active",
          "hotkey": "FIVE",
          "hotkey_mode": "toggle"
        }
      ]
    },
    {
      "name": "Build Preview",
      "gate": "preview",
      "commands": [
        {
          "name": "Rotation",
          "verb": "world.buildings.rotation.step 1",
          "verb_off": "world.buildings.rotation.step 15",
          "umg_text": "1 deg",
          "umg_text_off": "15 deg",
          "hotkey": "R",
          "hotkey_mode": "toggle"
        }
      ]
    },
    {
      "name": "Repair",
      "gate": "repair",
      "commands": [
        {
          "name": "Grab Building Piece",
          "verb": "build.preview.lookat",
          "hotkey": "E"
        },
        {
          "name": "Grab Actor",
          "verb": "camera.grab.toggle",
          "verb_off": "camera.grab.toggle",
          "umg_text": "Release",
          "umg_text_off": "Grab",
          "hotkey": "LEFT_MOUSE_BUTTON",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Inspect Actor",
          "verb": "camera.lookat",
          "hotkey": "RIGHT_MOUSE_BUTTON"
        },
        {
          "name": "Undo Grab",
          "verb": "camera.grab.cancel",
          "help_gate": "grab",
          "hotkey": "MIDDLE_MOUSE_BUTTON"
        },
        {
          "name": "Destroy Actor",
          "verb": "camera.destroy.lookat",
          "hotkey": "X",
          "modifiers": [
            "LEFT_CONTROL",
            "LEFT_ALT"
          ]
        },
        {
          "name": "Rotate Left",
          "verb": "camera.grab.rotate -1",
          "help_gate": "grab",
          "hotkey": "WHEEL_UP"
        },
        {
          "name": "Rotate Right",
          "verb": "camera.grab.rotate \u002B1",
          "help_gate": "grab",
          "hotkey": "WHEEL_DOWN"
        },
        {
          "name": "Move Up",
          "verb": "camera.grab.lift \u002B1",
          "help_gate": "grab",
          "hotkey": "WHEEL_UP",
          "modifiers": [
            "LEFT_CONTROL"
          ]
        },
        {
          "name": "Move Down",
          "verb": "camera.grab.lift -1",
          "help_gate": "grab",
          "hotkey": "WHEEL_DOWN",
          "modifiers": [
            "LEFT_CONTROL"
          ]
        },
        {
          "name": "Move Forward",
          "verb": "camera.grab.delta \u002B1",
          "help_gate": "grab",
          "hotkey": "WHEEL_UP",
          "modifiers": [
            "LEFT_ALT"
          ]
        },
        {
          "name": "Move Back",
          "verb": "camera.grab.delta -1",
          "help_gate": "grab",
          "hotkey": "WHEEL_DOWN",
          "modifiers": [
            "LEFT_ALT"
          ]
        },
        {
          "name": "Scale Up",
          "verb": "camera.grab.scale \u002B1",
          "help_gate": "grab",
          "hotkey": "WHEEL_UP",
          "modifiers": [
            "LEFT_SHIFT"
          ]
        },
        {
          "name": "Scale Down",
          "verb": "camera.grab.scale -1",
          "help_gate": "grab",
          "hotkey": "WHEEL_DOWN",
          "modifiers": [
            "LEFT_SHIFT"
          ]
        },
        {
          "name": "Destroy Tree",
          "verb": "world.foliage.tree.destroy.single",
          "hotkey": "X",
          "modifiers": [
            "LEFT_ALT"
          ]
        }
      ]
    },
    {
      "name": "Exit",
      "gate": "exit",
      "commands": [
        {
          "name": "Restore Building Costs",
          "verb": "world.buildings.requirements restore"
        },
        {
          "name": "Restore Damage",
          "verb": "player.field.set pawn.PlayerDamageComponent bCanTakeDamage true"
        }
      ]
    }
  ]
}