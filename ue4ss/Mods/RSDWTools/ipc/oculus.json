{
  "version": 5,
  "sections": [
    {
      "name": "Init",
      "gate": "init",
      "commands": [
        {
          "name": "Unlock Distance",
          "verb": "camera.oculus.distance 999999 999999"
        },
        {
          "name": "NoClip",
          "verb": "player.field.set pawn.OculusComponent.OculusPawn bActorEnableCollision false",
          "verb_off": "player.field.set pawn.OculusComponent.OculusPawn bActorEnableCollision true"
        },
        {
          "name": "Hide Vignette",
          "verb": "camera.oculus.vignette off"
        },
        {
          "name": "Hide Watermark",
          "verb": "camera.oculus.watermark off"
        },
        {
          "name": "Rotation Sensitivity",
          "verb": "camera.oculus.rotation.sensitivity 0.48 0.36 0.48"
        },
        {
          "name": "Rotation Freeze Speed",
          "verb": "camera.oculus.rotation.freeze 0.01"
        },
        {
          "name": "Rotation Look Lock",
          "verb": "camera.oculus.rotation.look locked 0.001"
        },
        {
          "name": "Scale Sensitivity",
          "verb": "camera.oculus.scale.sensitivity 0.01 0.01"
        },
        {
          "name": "Scale Bounds",
          "verb": "camera.oculus.scale.bounds 0.05 50"
        },
        {
          "name": "Scale Freeze Speed",
          "verb": "camera.oculus.scale.freeze 0.01"
        },
        {
          "name": "Scale Look Lock",
          "verb": "camera.oculus.scale.look locked 0.001"
        },
        {
          "name": "Grab Steps",
          "verb": "camera.grab.steps 50 25 15 0.1 0.05 50"
        },
        {
          "name": "Grab Safety Default",
          "verb": "camera.grab.safety on"
        },
        {
          "name": "Save Building Costs",
          "verb": "world.buildings.requirements save"
        },
        {
          "name": "Clear Building Costs",
          "verb": "world.buildings.requirements clear"
        },
        {
          "name": "Placement Distance",
          "verb": "player.field.set controller.BuildPlacementComponent MaxPlacementDistance 1000.0"
        },
        {
          "name": "No Damage",
          "verb": "player.field.set pawn.PlayerDamageComponent bCanTakeDamage false"
        }
      ]
    },
    {
      "name": "Inactive",
      "gate": "inactive",
      "commands": [
        {
          "name": "Start",
          "verb": "camera.oculus.start",
          "hotkey": "INS"
        }
      ]
    },
    {
      "name": "Active",
      "gate": "active",
      "commands": [
        {
          "name": "Camera Speed",
          "verb": "camera.oculus.speed 3600 12000 24000",
          "verb_off": "camera.oculus.speed 1200 4000 8000",
          "umg_text": "Fast (3x)",
          "umg_text_off": "Default",
          "hotkey": "ONE",
          "hotkey_mode": "toggle"
        },
        {
          "name": "HUD",
          "verb": "player.field.call hud ShowHUD",
          "verb_off": "player.field.call hud ShowHUD",
          "verbs": [
            "player.field.call hud ShowHUD",
            "camera.oculus.watermark off",
            "camera.oculus.help off"
          ],
          "verbs_off": [
            "player.field.call hud ShowHUD",
            "camera.oculus.help on"
          ],
          "umg_text": "Hidden",
          "umg_text_off": "Visible",
          "hotkey": "TWO",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Time",
          "verb": "world.time 1.0",
          "verb_off": "world.time 0",
          "umg_text": "Toggle",
          "umg_text_off": "Toggle",
          "hotkey": "THREE",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Weather",
          "verb": "world.weather.regional Sunny",
          "verbs": [
            "world.weather.regional Sunny",
            "umg 3 Setting Sunny: Please Wait"
          ],
          "umg_text": "Sunny",
          "hotkey": "FOUR"
        },
        {
          "name": "AI",
          "verb": "world.foreach DominionAICharacter set CustomTimeDilation 0",
          "verb_off": "world.foreach DominionAICharacter set CustomTimeDilation 1.0",
          "umg_text": "Paused",
          "umg_text_off": "Active",
          "hotkey": "FIVE",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Grab Safety",
          "verb": "camera.grab.safety off",
          "verb_off": "camera.grab.safety on",
          "umg_text": "Off",
          "umg_text_off": "On",
          "hotkey": "SIX",
          "hotkey_mode": "toggle"
        }
      ]
    },
    {
      "name": "Build Preview",
      "gate": "preview",
      "commands": [
        {
          "name": "Rotation",
          "verb": "world.buildings.rotation.step 1",
          "verb_off": "world.buildings.rotation.step 15",
          "umg_text": "1 deg",
          "umg_text_off": "15 deg",
          "hotkey": "R",
          "hotkey_mode": "toggle"
        },
        {
          "name": "Force Place",
          "verb": "build.preview.force_place",
          "hotkey": "V"
        }
      ]
    },
    {
      "name": "Repair",
      "gate": "repair",
      "commands": [
        {
          "name": "Inspect",
          "verb": "camera.lookat",
          "hotkey": "RIGHT_MOUSE_BUTTON"
        },
        {
          "name": "Grab",
          "verb": "camera.oculus.mode.grab",
          "hotkey": "G"
        },
        {
          "name": "Release",
          "verb": "camera.grab.release",
          "help_gate": "grab",
          "hotkey": "LEFT_MOUSE_BUTTON"
        },
        {
          "name": "Rotate",
          "verb": "camera.oculus.mode.rotation",
          "hotkey": "R"
        },
        {
          "name": "Scale",
          "verb": "camera.oculus.mode.scale",
          "hotkey": "V"
        },
        {
          "name": "Duplicate",
          "verb": "camera.oculus.duplicate",
          "hotkey": "E"
        },
        {
          "name": "Undo Grab",
          "verb": "camera.grab.cancel",
          "help_gate": "grab",
          "hotkey": "MIDDLE_MOUSE_BUTTON"
        },
        {
          "name": "Destroy",
          "verb": "camera.destroy.lookat",
          "hotkey": "X",
          "modifiers": [
            "LEFT_CONTROL",
            "LEFT_ALT"
          ]
        },
        {
          "name": "Rotate Left",
          "verb": "camera.grab.rotate -1",
          "help_gate": "grab"
        },
        {
          "name": "Rotate Right",
          "verb": "camera.grab.rotate +1",
          "help_gate": "grab"
        },
        {
          "name": "Scale Up",
          "verb": "camera.grab.scale +1",
          "help_gate": "grab"
        },
        {
          "name": "Scale Down",
          "verb": "camera.grab.scale -1",
          "help_gate": "grab"
        },
        {
          "name": "Move Up",
          "verb": "camera.grab.lift +1",
          "help_gate": "grab"
        },
        {
          "name": "Move Down",
          "verb": "camera.grab.lift -1",
          "help_gate": "grab"
        },
        {
          "name": "Move Forward",
          "verb": "camera.grab.delta +1",
          "help_gate": "grab"
        },
        {
          "name": "Move Back",
          "verb": "camera.grab.delta -1",
          "help_gate": "grab"
        },
        {
          "name": "Grab Safety",
          "verb": "camera.grab.safety toggle"
        }
      ]
    },
    {
      "name": "Rotation Mode",
      "gate": "rotation",
      "commands": [
        {
          "name": "Free Rotation",
          "verb": "camera.oculus.rotation.mode free",
          "hotkey": "F"
        },
        {
          "name": "Lock Roll",
          "verb": "camera.oculus.rotation.mode x",
          "hotkey": "X"
        },
        {
          "name": "Lock Pitch",
          "verb": "camera.oculus.rotation.mode y",
          "hotkey": "Y"
        },
        {
          "name": "Lock Yaw",
          "verb": "camera.oculus.rotation.mode z",
          "hotkey": "Z"
        },
        {
          "name": "Reset Rotation",
          "verb": "camera.oculus.rotation.reset",
          "hotkey": "MIDDLE_MOUSE_BUTTON"
        },
        {
          "name": "Confirm Rotation",
          "verb": "camera.oculus.rotation.stop",
          "help_gate": "hidden",
          "hotkey": "LEFT_MOUSE_BUTTON"
        }
      ]
    },
    {
      "name": "Scale Mode",
      "gate": "scale",
      "commands": [
        {
          "name": "Lock X Scale",
          "verb": "camera.oculus.scale.mode x",
          "hotkey": "X"
        },
        {
          "name": "Lock Y Scale",
          "verb": "camera.oculus.scale.mode y",
          "hotkey": "Y"
        },
        {
          "name": "Lock Z Scale",
          "verb": "camera.oculus.scale.mode z",
          "hotkey": "Z"
        },
        {
          "name": "Reset Scale",
          "verb": "camera.oculus.scale.reset",
          "hotkey": "MIDDLE_MOUSE_BUTTON"
        },
        {
          "name": "Confirm Scale",
          "verb": "camera.oculus.scale.stop",
          "help_gate": "hidden",
          "hotkey": "LEFT_MOUSE_BUTTON"
        }
      ]
    },
    {
      "name": "Exit",
      "gate": "exit",
      "commands": [
        {
          "name": "Restore Grabbed Actor",
          "verb": "camera.grab.safe_cancel"
        },
        {
          "name": "Restore Building Costs",
          "verb": "world.buildings.requirements restore"
        },
        {
          "name": "Restore Damage",
          "verb": "player.field.set pawn.PlayerDamageComponent bCanTakeDamage true"
        },
        {
          "name": "Restore Grab Safety",
          "verb": "camera.grab.safety on"
        }
      ]
    }
  ]
}
